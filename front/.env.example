# 复制为 .env：copy .env.example .env

# Spring 后端（任务 API、上传、Roboflow 代理）
VITE_RASTER_API_URL=http://localhost:8080

# TiTiler（生产或非 Vite 代理时直连；开发默认同源 /titiler-proxy）
VITE_TITILER_URL=http://localhost:8000
# VITE_TITILER_USE_PROXY=false

# WebSocket：开发默认同源 /ws 代理到 Spring
# VITE_WS_USE_PROXY=true
# VITE_WS_URL=http://localhost:8080

# 地物推理（可选，覆盖 Spring roboflow.*）
# VITE_ROBOFLOW_MODEL_ID=my-project/1
# VITE_ROBOFLOW_INFERENCE_BASE_URL=http://127.0.0.1:9001
# VITE_ROBOFLOW_INFERENCE_WORKSPACE=
# VITE_ROBOFLOW_INFERENCE_WORKFLOW_ID=
