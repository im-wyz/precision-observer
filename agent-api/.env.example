# 复制为 .env 后填写真实值（.env 勿提交 Git）
# cp .env.example .env   或  copy .env.example .env

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=agent:task:
REDIS_PUBSUB_CHANNEL_PREFIX=task:
REDIS_TTL_SECONDS=86400

# 二选一：通义填 DASHSCOPE_API_KEY 即可，OPENAI_API_KEY 可留空
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

MCP_ENABLED=true
MCP_GEE_URL=http://127.0.0.1:8101/sse
MCP_GDAL_URL=http://127.0.0.1:8102/sse
MCP_RASTER_URL=http://127.0.0.1:8103/sse
MCP_STORAGE_URL=http://127.0.0.1:8104/sse
MCP_INFERENCE_URL=http://127.0.0.1:8105/sse
MCP_CONNECT_TIMEOUT_SEC=8
MCP_GEE_TOOL_TIMEOUT_SEC=600
# Engineer 在 MCP 模式下默认通过 gee-mcp 执行 GEE；仅调试时可设为 false 本机直连
GEE_FORCE_MCP=true
# MCP 不可用时是否允许 Engineer 回退到本机 GEE 工具（生产建议 false）
ENGINEER_ALLOW_LOCAL_GEE_FALLBACK=false
MCP_MAX_TOOL_ROUNDS=8

GEE_CREDENTIALS_PATH=../secrets/gee-service-account.json
GEE_OUTPUT_DIR=./data/gee_exports
GEE_LOCAL_HTTP_BASE=http://127.0.0.1:8001/files/gee_exports
GEE_UPLOAD_MINIO=auto
GEE_EXPORT_SCALE=10
GEE_EXPORT_BUCKET=
# 访问 Google OAuth 不稳定时可配置代理（可选）
# HTTPS_PROXY=http://127.0.0.1:7890

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=precision-observer
MINIO_SECURE=false
MINIO_PUBLIC_BASE=http://127.0.0.1:9000
# TiTiler 在 Docker 内、MinIO 在宿主机时填写：
# TITILER_COG_FETCH_BASE=http://host.docker.internal:9000
TITILER_COG_FETCH_BASE=
TITILER_BASE_URL=http://127.0.0.1:8000

MAX_ANALYST_ROUNDS=5
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8001
